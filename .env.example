# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a GitHub (está en .gitignore).

# Clave de la IA (Anthropic). Se consigue en https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Texto secreto largo para firmar las sesiones (login). Inventá uno, por ejemplo 40 letras y números al azar.
SESSION_SECRET=

# Token secreto que usa el Google Apps Script de Gmail para leer /api/configuracion.
# Inventá uno largo y pegá el mismo valor en el script de Gmail.
CONFIG_API_TOKEN=

# Base de datos Upstash Redis. En Vercel se cargan solas al conectar Upstash.
# Si quedan vacías en tu compu, la app guarda los datos en memoria (se borran al reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=
