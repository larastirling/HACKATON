# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a GitHub (está en .gitignore).

# Clave de la IA (Anthropic). Se consigue en https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Texto secreto largo para firmar las sesiones (login). Inventá uno, por ejemplo 40 letras y números al azar.
SESSION_SECRET=

# Token secreto que usa el Google Apps Script de Gmail para leer /api/configuracion.
# Inventá uno largo y pegá el mismo valor en el script de Gmail.
CONFIG_API_TOKEN=

# Base de datos Upstash Redis. En Vercel se cargan solas al conectar Upstash.
# Si quedan vacías en tu compu, la app guarda los datos en memoria (se borran al reiniciar).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Gmail de la demo para mandar los pedidos de aprobación a la familia.
# GMAIL_CONTRASENA_APP es una "contraseña de aplicación" de Gmail (16 letras), NO la contraseña normal.
# Si quedan vacías en tu compu, los mails no se mandan: se muestran en la Terminal para probar.
GMAIL_USUARIO=
GMAIL_CONTRASENA_APP=

# Dirección pública de la app, para los links de los mails (por ejemplo https://tu-app.vercel.app).
# Si queda vacía, se usa la dirección desde donde se abrió la app.
URL_APP=

# Minutos que tiene cada familiar para contestar un pedido de aprobación (si queda vacío: 5).
# Para la demo se puede bajar, por ejemplo a 1.
MINUTOS_PARA_CONTESTAR=

# Notificaciones en el celular de la familia (Web Push). Se generan una sola vez con:
#   npx web-push generate-vapid-keys
# La privada NUNCA va en el código. Si quedan vacías, no hay notificaciones (los mails salen igual).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
